{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered DPO or compliance officer profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "organization": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "AuditReport": {
      "title": "AuditReport",
      "description": "Moroccan Law 08/09 Compliance Audit Report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "target": { "type": "string" },
        "domain": { "type": "string" },
        "score": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "domain", "score"]
    },
    "DpoSecurityAlert": {
      "title": "DpoSecurityAlert",
      "description": "Simulated or real security alert notifications dispatched to registered DPO",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "dpoEmail": { "type": "string" },
        "dpoName": { "type": "string" },
        "companyName": { "type": "string" },
        "targetDomain": { "type": "string" },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH"] },
        "gapTitle": { "type": "string" },
        "article": { "type": "string" },
        "penaltyEstimate": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string", "enum": ["DELIVERED", "FAILED"] }
      },
      "required": ["id", "userId", "dpoEmail", "targetDomain", "gapTitle", "severity"]
    },
    "AuditTrailItem": {
      "title": "AuditTrailItem",
      "description": "Chronological audit trail activity log of manual user actions and compliance scans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string" },
        "category": { "type": "string" },
        "actionTitleAr": { "type": "string" },
        "actionTitleEn": { "type": "string" },
        "actorEmail": { "type": "string" },
        "targetResource": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "category", "actionTitleEn", "actorEmail", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account profile and settings"
    },
    "/auditReports/{reportId}": {
      "schema": "AuditReport",
      "description": "User compliance audit scan reports"
    },
    "/dpoAlerts/{alertId}": {
      "schema": "DpoSecurityAlert",
      "description": "DPO high-risk security vulnerability notifications"
    },
    "/auditTrail/{eventId}": {
      "schema": "AuditTrailItem",
      "description": "User compliance session audit trail activities"
    }
  }
}
