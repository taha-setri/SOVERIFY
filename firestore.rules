rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Audit Reports access
    match /auditReports/{reportId} {
      allow read, write: if true;
    }

    // DPO Security Alert Notifications access
    match /dpoAlerts/{alertId} {
      allow read, write: if true;
    }

    // Audit Trail Activity Logs access
    match /auditTrail/{eventId} {
      allow read, write: if true;
    }

    // Chat history access
    match /chatMessages/{msgId} {
      allow read, write: if true;
    }
  }
}
